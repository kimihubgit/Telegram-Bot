# Telegram Bot Token - Lấy từ @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Username của Bot (Username không kèm dấu @)
BOT_USERNAME=YOUR_BOT_USERNAME_HERE

# Admin Chat ID - Gửi lệnh /myid cho bot để lấy Chat ID của bạn, sau đó điền vào đây
ADMIN_CHAT_ID=6671xxxxxxx

# Telethon (Userbot) - Lấy từ https://my.telegram.org/app (Có thể bỏ trống nếu không dùng)
TELETHON_API_ID=11xxxx
TELETHON_API_HASH=33xxxxxxxxxxxxxxxxxx343khs

# Tạo group mới → thêm @MissRose_bot → lấy Chat ID Group bằng /myid
# Rose Bot Query Group — Group riêng này chỉ có bạn + Rose Bot
ROSE_QUERY_GROUP_ID=-100xxxxxxxxxx

# Notification Admin IDs — Ai được dùng lệnh /notification (phân cách bằng dấu phẩy)
# Nếu để trống, sẽ dùng ADMIN_CHAT_ID làm mặc định
NOTIFICATION_ADMIN_IDS=66xxxxxx

# [TÙY CHỌN] Backup Bot — Token riêng để gửi file log/data backup
# Tạo bot mới ở @BotFather, lấy token điền vào đây
# BACKUP_CHAT_ID: Chat ID nơi nhận backup (có thể là admin ID hoặc channel ID)
BACKUP_BOT_TOKEN=
BACKUP_CHAT_ID=

# === Cấu hình MongoDB Cục Bộ / Đám Mây ===
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=telegram

# === Cấu hình quyên góp /donate ===
DONATE_BANK_NAME=MB Bank (Ngân hàng Quân Đội)
DONATE_BANK_ACC=999999999999
DONATE_BANK_OWNER=VU KHANH AN
DONATE_BINANCE_ID=123456789
DONATE_TRC20_WALLET=TX1234567890QWERTYUIOPASDFGHJKLZXC
DONATE_PORT=8080

# === Cấu hình Autobank Polling Server ===
AUTOBANK_POLL_INTERVAL=30

# === API Key Binance (Để tự động quét ví Binance Pay) ===
BINANCE_API_KEY=YOUR_BINANCE_API_KEY
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET

@echo off
chcp 65001 >nul
title 🤖 Telegram Bot — Quick Setup
color 0A

echo ═══════════════════════════════════════════════
echo   🤖 TELEGRAM BOT — KIMIDEV COMMUNITY
echo   📦 Quick Setup Script
echo ═══════════════════════════════════════════════
echo.

:: ─────────────────────────────────────
:: 1. Check Python
:: ─────────────────────────────────────
echo [1/5] Kiểm tra Python...
python --version >nul 2>&1
if errorlevel 1 (
    echo ❌ Python chưa được cài đặt!
    echo 👉 Tải tại: https://www.python.org/downloads/
    pause
    exit /b 1
)
for /f "tokens=2" %%i in ('python --version 2^>^&1') do set PYVER=%%i
echo ✅ Python %PYVER%
echo.

:: ─────────────────────────────────────
:: 2. Install dependencies
:: ─────────────────────────────────────
echo [2/5] Cài đặt dependencies...
pip install -r requirements.txt --quiet
if errorlevel 1 (
    echo ❌ Lỗi cài đặt dependencies!
    pause
    exit /b 1
)
echo ✅ Dependencies đã cài xong.
echo.

:: ─────────────────────────────────────
:: 3. Create directories
:: ─────────────────────────────────────
echo [3/5] Tạo thư mục cần thiết...
if not exist "data" mkdir data
if not exist "data\cookies" mkdir data\cookies
if not exist "data\cookies_used" mkdir data\cookies_used
if not exist "log" mkdir log
if not exist "bot\sessions" mkdir bot\sessions
echo ✅ Thư mục đã sẵn sàng.
echo.

:: ─────────────────────────────────────
:: 4. Create .env
:: ─────────────────────────────────────
echo [4/5] Cấu hình .env...
if exist ".env" (
    echo ⚠️  File .env đã tồn tại — giữ nguyên.
    echo    Nếu muốn reset, xóa file .env rồi chạy lại setup.
) else (
    echo 📝 Tạo file .env từ mẫu...
    echo.

    :: Prompt BOT_TOKEN
    set /p BOT_TOKEN="🔑 Nhập BOT_TOKEN (từ @BotFather): "
    if "%BOT_TOKEN%"=="" set BOT_TOKEN=YOUR_BOT_TOKEN_HERE

    :: Prompt ADMIN_CHAT_ID
    set /p ADMIN_CHAT_ID="👤 Nhập ADMIN_CHAT_ID (ID Telegram của bạn): "
    if "%ADMIN_CHAT_ID%"=="" set ADMIN_CHAT_ID=YOUR_ADMIN_CHAT_ID_HERE

    :: Prompt Telethon
    echo.
    set /p USE_TELETHON="🔓 Bạn có muốn dùng Telethon (OSINT sâu)? (y/n): "
    if /i "%USE_TELETHON%"=="y" (
        set /p TELETHON_API_ID="   📱 TELETHON_API_ID: "
        set /p TELETHON_API_HASH="   🔐 TELETHON_API_HASH: "
    ) else (
        set TELETHON_API_ID=
        set TELETHON_API_HASH=
    )

    :: Write .env file
    (
        echo # ═══════════════════════════════════════
        echo # Telegram Bot — Kimidev Community
        echo # Generated by setup.bat
        echo # ═══════════════════════════════════════
        echo.
        echo # [BẮT BUỘC] Bot Token từ @BotFather
        echo BOT_TOKEN=%BOT_TOKEN%
        echo.
        echo # [BẮT BUỘC] Admin Chat ID
        echo ADMIN_CHAT_ID=%ADMIN_CHAT_ID%
        echo.
        echo # [TÙY CHỌN] Telethon — mở khóa OSINT sâu
        echo TELETHON_API_ID=%TELETHON_API_ID%
        echo TELETHON_API_HASH=%TELETHON_API_HASH%
        echo.
        echo # [TÙY CHỌN] Rose Bot Query Group
        echo ROSE_QUERY_GROUP_ID=
        echo.
        echo # [TÙY CHỌN] Admin IDs cho /notification (phân cách bằng dấu phẩy)
        echo NOTIFICATION_ADMIN_IDS=%ADMIN_CHAT_ID%
    ) > .env

    echo.
    echo ✅ File .env đã được tạo!
)
echo.

:: ─────────────────────────────────────
:: 5. Init data files
:: ─────────────────────────────────────
echo [5/5] Khởi tạo data files...
if not exist "data\banlist.json" (
    echo {"users": {}, "severity_levels": {"scam": {"label": "🔴 Lừa đảo", "action": "ban"}, "fake_bio": {"label": "🟠 Giả mạo Bio", "action": "ban"}, "spam": {"label": "🟡 Spam", "action": "mute"}, "left_group": {"label": "🚪 Tự rời nhóm", "action": "ban"}}} > data\banlist.json
)
if not exist "data\members.json" echo {} > data\members.json
if not exist "data\known_users.json" echo {} > data\known_users.json
if not exist "data\user_violations.json" echo {} > data\user_violations.json
echo ✅ Data files đã sẵn sàng.

echo.
echo ═══════════════════════════════════════════════
echo   ✅ SETUP HOÀN TẤT!
echo ═══════════════════════════════════════════════
echo.
echo   Chạy bot bằng lệnh:
echo     python main.py
echo.
echo   Lần đầu chạy với Telethon sẽ cần nhập
echo   số điện thoại + mã OTP.
echo.
echo ═══════════════════════════════════════════════
pause
